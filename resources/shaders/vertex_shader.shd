#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;

out vec3 pos;
out vec3 WorldNormal;
out vec3 LocalNormal;

uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;

void main()
{
    // Pozicija u svetskom prostoru za proračun svetla
    pos = vec3(model * vec4(aPos, 1.0));

    // Normala u svetskom prostoru (prati rotaciju za svetlo)
    WorldNormal = mat3(transpose(inverse(model))) * aNormal;

    // Originalna normala u lokalnom prostoru (NE menja se rotacijom, nosi boju)
    LocalNormal = aNormal;

    gl_Position = projection * view * vec4(pos, 1.0);
}