# OBJ fajl za jednu kockicu Rubikove kocke
mtllib sub_cube.mtl
# Pozicije temena (Positions)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

# Teksturne koordinate (UVCoords)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normale (Normals)
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# Stranice / Trouglovi (Faces: pos/uv/norm)
# Prednja strana
usemtl cubie
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
# Zadnja strana
f 6/1/2 5/2/2 8/3/2
f 6/1/2 8/3/2 7/4/2
# Leva strana
f 5/1/3 1/2/3 4/3/3
f 5/1/3 4/3/3 8/4/3
# Desna strana
f 2/1/4 6/2/4 7/3/4
f 2/1/4 7/3/4 3/4/4
# Gornja strana
f 4/1/5 3/2/5 7/3/5
f 4/1/5 7/3/5 8/4/5
# Donja strana
f 5/1/6 6/2/6 2/3/6
f 5/1/6 2/3/6 1/4/6